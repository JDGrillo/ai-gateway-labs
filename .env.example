# Copy to .env and fill in these three settings for all notebooks.
# AI Gateway portal > model Overview > Chat completions: copy the full HTTPS URL.
AI_GATEWAY_CHAT_URL=
# AI Gateway portal > Access > Keys: create/copy a gateway runtime key.
AI_GATEWAY_API_KEY=
# AI Gateway portal > Models > Aliases: copy the callable alias, not its resource ID.
# For notebook 3, choose an alias with two compatible Chat Completions targets.
AI_GATEWAY_MODEL_ALIAS=
